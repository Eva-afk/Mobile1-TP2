<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/main_linearContainer"
    tools:context=".HistoriqueActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_historique"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <NumberPicker
        android:id="@+id/nombreBondsArriere"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <Button
        android:id="@+id/retourHistoriqueBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/retourArriere"
        app:layout_constraintStart_toStartOf="@+id/item_txt_departement"
        app:layout_constraintTop_toBottomOf="@+id/item_txt_departement" />
</LinearLayout>
